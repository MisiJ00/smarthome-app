{
  "expo": {
    "name": "Smart Home",
    "slug": "smarthome",
    "scheme": "smarthome",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.homeserver.smarthome"
    },
    "android": {
      "package": "dev.homeserver.smarthome",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickSwitch",
              "label": "Schnellschalter",
              "description": "Bis zu vier Geräte mit einem Tipp schalten",
              "previewImage": "./assets/widget-preview.png",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "340dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "SingleDevice",
              "label": "Einzelgerät",
              "description": "Ein Gerät als eigenes Widget, Tipp schaltet",
              "previewImage": "./assets/widget-preview-single.png",
              "minWidth": "57dp",
              "minHeight": "57dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { *; } -keep class androidx.work.** { *; } -dontwarn androidx.room.paging.**"
          }
        }
      ],
      "./plugins/with-short-native-build-dir",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#f3f5f9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0e131c"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
